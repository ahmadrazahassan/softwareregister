# Supabase. Leave blank to run the site on the bundled local dataset.
# The public site works without these. The admin area does not: it fails closed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by scripts and form handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for canonicals, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://softwareregister.co.za

# Salt for hashing visitor IP addresses before storage. POPIA: never store a raw IP.
IP_HASH_SALT=change-me-to-a-long-random-string

# Optional. Turns on double opt in confirmation emails for The Dispatch.
# Without these, subscriptions are recorded as confirmed at the moment of consent.
RESEND_API_KEY=
DISPATCH_FROM=Software Register <hello@softwareregister.co.za>

# Optional verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Admin bootstrap, used only by `npm run create-admin`
ADMIN_EMAIL=
ADMIN_PASSWORD=
